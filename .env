PORT=3000

# PostgreSQL bağlantısı (Railway otomatik verir)
DATABASE_URL=postgres://kullanici:sifre@host:5432/reyiz
PGSSL=true

# Güvenlik anahtarları — uzun ve rastgele olmalı
JWT_SECRET=uzun-rastgele-bir-anahtar-girin
SIGN_SECRET=ayri-uzun-rastgele-bir-anahtar

# İlk admin hesabı (seed.js ile oluşturulur)
ADMIN_EMAIL=admin@reyizmarket.click
ADMIN_PASSWORD=degistir-bu-sifreyi

# Ödeme: mock (anında başarılı, sadece test) | manual (admin onayı) | iyzico
PAYMENT_MODE=manual

# Manuel ödeme — Banka/IBAN bilgileri (checkout sayfasında gösterilir)
BANK_IBAN=
BANK_NAME=
BANK_OWNER=

# Dosya depolama
STORAGE_DIR=./storage

# ---- iyzico (TEST modu; canlıya alırken gerçek anahtarları gir) ----
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# ---- Cloudflare R2 (OPSİYONEL) ----
# Boş bırakılırsa oyun dosyaları sunucunun local storage klasöründe saklanır.
R2_ENDPOINT=https://0a179ad52bdb43871f83b3cfb33c2049.r2.cloudflarestorage.com
R2_ACCESS_KEY=499f0411c5e921db6d082a47ca1f597b
R2_SECRET_KEY=21ba8401d185bd39606607b3e2525bc3fb6d635c8a70fa217c029426aaf2c1c8
R2_BUCKET=market
