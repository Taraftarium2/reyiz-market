<%- include('partials/header') %>

<div class="auth-wrap">
  <div class="auth-box">
    <div class="auth-logo">⚡</div>
    <h2>Hesap oluştur</h2>
    <p class="auth-sub">Ücretsiz kayıt ol, oyunları keşfet</p>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert"><%= error %></div>
    <% } %>

    <form method="post" action="/kayit" class="form" id="registerForm">
      <div class="form-group">
        <label for="regName">Adın</label>
        <input id="regName" name="name" placeholder="Adın Soyadın" autocomplete="name">
      </div>
      <div class="form-group">
        <label for="regEmail">E-posta</label>
        <input id="regEmail" type="email" name="email" placeholder="ornek@mail.com" required autocomplete="email">
      </div>
      <div class="form-group">
        <label for="regPass">Şifre <span style="color:var(--faint);font-weight:400">(en az 6 karakter)</span></label>
        <input id="regPass" type="password" name="password" placeholder="••••••••" required minlength="6" autocomplete="new-password">
      </div>
      <button class="btn big" type="submit">Hesap Oluştur →</button>
    </form>

    <p class="auth-footer">Zaten hesabın var mı? <a href="/giris">Giriş yap</a></p>
  </div>
</div>

<%- include('partials/footer') %>