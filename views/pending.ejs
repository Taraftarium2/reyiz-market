<%- include('partials/header') %>

<div class="pending-wrap">
  <div class="pending-box">
    <div class="pending-icon">⏳</div>
    <h2>Ödeme Bekleniyor</h2>
    <p class="pending-sub">Aşağıdaki banka hesabına havale / EFT yap. Ödeme onaylandıktan sonra oyunlar kütüphanene eklenir.</p>

    <% if (typeof hata !== 'undefined' && hata) { %>
      <div class="alert" style="background:rgba(239,68,68,.12);border:1px solid rgba(239,68,68,.35);color:#f87171;border-radius:var(--radius);padding:14px 18px;margin-bottom:18px;text-align:left">
        <strong>❌ Onay başarısız oldu, sipariş kütüphaneye eklenmedi.</strong>
        <div style="font-size:.82rem;margin-top:6px;opacity:.9"><%= hata %></div>
      </div>
    <% } %>

    <!-- Sipariş Kodu -->
    <div class="ref-box">
      <div class="ref-label">📋 Açıklama / Sipariş Kodu — Havaleye mutlaka yaz!</div>
      <div class="ref-row">
        <div class="ref-value" id="refCode"><%= order.payment_ref %></div>
        <button class="btn-copy" onclick="copyRef()" id="copyBtn">📋 Kopyala</button>
      </div>
    </div>

    <!-- IBAN Bilgisi -->
    <% if (iban) { %>
    <div class="iban-box">
      <div class="iban-row">
        <span class="iban-label">Banka</span>
        <span class="iban-val"><%= bankName %></span>
      </div>
      <div class="iban-row">
        <span class="iban-label">Hesap Sahibi</span>
        <span class="iban-val"><%= bankOwner %></span>
      </div>
      <div class="iban-row">
        <span class="iban-label">IBAN</span>
        <div style="display:flex;align-items:center;gap:8px">
          <span class="iban-val iban-num" id="ibanNum"><%= iban %></span>
          <button class="btn-copy-sm" onclick="copyIban()" title="IBAN kopyala">📋</button>
        </div>
      </div>
      <div class="iban-row">
        <span class="iban-label">Tutar</span>
        <span class="iban-val" style="color:var(--orange2);font-size:1.1rem;font-weight:800">₺<%= Number(order.total_amount).toFixed(2) %></span>
      </div>
    </div>
    <% } else { %>
    <div class="alert" style="margin-bottom:18px">Banka bilgileri ayarlanmamış. Admin ile iletişime geç.</div>
    <% } %>

    <!-- Sipariş İçeriği -->
    <div class="order-items-list">
      <div class="oil-header">Sipariş İçeriği</div>
      <% items.forEach(function(item) { %>
      <div class="order-item-row">
        <span><%= item.title %></span>
        <span class="price-sm">₺<%= Number(item.price_at_purchase).toFixed(2) %></span>
      </div>
      <% }) %>
      <div class="order-item-row total-row">
        <span>Toplam</span>
        <span class="price-sm" style="font-size:1rem">₺<%= Number(order.total_amount).toFixed(2) %></span>
      </div>
    </div>

    <!-- Ödemeyi Yaptım Butonu / Bildirimi -->
    <% if (order.payment_provider === 'manual_notified') { %>
      <div class="alert alert-success" style="text-align:center;margin-bottom:16px;font-weight:600">
        ⚡ Havale yaptığınız bildirildi. Admin kontrol edip kısa sürede onaylayacaktır.
      </div>
    <% } else { %>
      <form method="post" action="/odeme/beklemede/<%= order.id %>/bildir" style="margin-bottom:12px;text-align:center">
        <button class="btn big success-btn" type="submit" style="width:100%;padding:14px">⚡ Havaleyi Yaptım (Admine Bildir)</button>
      </form>
    <% } %>

    <!-- ADMIN HIZLI ONAY BUTONU (TEST İÇİN) -->
    <% if (user && user.role === 'admin') { %>
      <form method="post" action="/odeme/beklemede/<%= order.id %>/hizli-onay" style="margin-bottom:18px">
        <button class="btn big" type="submit" style="width:100%;padding:14px;background:linear-gradient(135deg,#8b5cf6,#ec4899);color:#fff">⚡ Admin Hızlı Onayla & Kütüphaneme Git ➔</button>
      </form>
    <% } %>

    <!-- Adım Göstergesi -->
    <div class="pending-steps">
      <div class="pstep done">✓ Sipariş oluşturuldu</div>
      <div class="pstep active">⏳ Havale bekleniyor</div>
      <div class="pstep">📦 Kütüphaneye ekleme</div>
    </div>

    <div class="pending-actions">
      <a class="btn ghost" href="/siparislerim">Tüm Siparişlerim</a>
      <a class="btn" href="/profil/kutuphanem">Kütüphanem</a>
    </div>

    <p class="note" style="margin-top:16px;text-align:center">
      ⚠️ Havale açıklamasına mutlaka <strong><%= order.payment_ref %></strong> yaz.<br>
      Aksi hâlde ödemen eşleştirilemez.
    </p>
  </div>
</div>

<script>
function copyRef() {
  navigator.clipboard.writeText('<%= order.payment_ref %>').then(function() {
    var btn = document.getElementById('copyBtn');
    btn.textContent = '✅ Kopyalandı!';
    btn.style.borderColor = 'var(--green)';
    btn.style.color = 'var(--green)';
    setTimeout(function() { btn.textContent = '📋 Kopyala'; btn.style.borderColor = ''; btn.style.color = ''; }, 2500);
  });
}
function copyIban() {
  navigator.clipboard.writeText('<%= iban %>').then(function() {
    var btns = document.querySelectorAll('.btn-copy-sm');
    btns.forEach(function(b) { b.textContent = '✅'; setTimeout(function() { b.textContent = '📋'; }, 2000); });
  });
}
</script>

<%- include('partials/footer') %>
