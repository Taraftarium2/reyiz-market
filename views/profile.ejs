<%- include('partials/header') %>

<div class="container section">
    <div class="auth-card">
        <h2><i class="fa-solid fa-circle-user"></i> Profil Bilgileri</h2>
        <div class="profile-details">
            <p><strong>Kullanıcı Adı:</strong> <%= user.username %></p>
            <p><strong>E-Posta:</strong> <%= user.email %></p>
            <p><strong>Rol:</strong> <%= user.role.toUpperCase() %></p>
            <p><strong>Kayıt Tarihi:</strong> <%= new Date(user.created_at).toLocaleDateString('tr-TR') %></p>
        </div>
        <a href="/auth/logout" class="btn btn-danger btn-block mt-3">Çıkış Yap</a>
    </div>
</div>

<%- include('partials/footer') %>
