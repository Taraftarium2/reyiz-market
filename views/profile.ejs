<%- include('partials/header') %>

<section class="section">
  <div style="max-width:520px">
    <h2 style="margin-bottom:24px">👤 Profilim</h2>
    <div class="profile-box">
      <div class="profile-row">
        <span class="profile-key">Ad</span>
        <span class="profile-val"><%= info.name %></span>
      </div>
      <div class="profile-row">
        <span class="profile-key">E-posta</span>
        <span class="profile-val"><%= info.email %></span>
      </div>
      <div class="profile-row">
        <span class="profile-key">Rol</span>
        <span class="profile-val">
          <% if (info.role === 'admin') { %><span class="badge badge-paid">⚙ Admin</span><% } else { %><span class="badge">Kullanıcı</span><% } %>
        </span>
      </div>
      <div class="profile-row">
        <span class="profile-key">Üyelik Tarihi</span>
        <span class="profile-val"><%= new Date(info.created_at).toLocaleDateString('tr-TR', {day:'2-digit',month:'long',year:'numeric'}) %></span>
      </div>
    </div>
    <div style="display:flex;gap:10px;margin-top:20px;flex-wrap:wrap">
      <a class="btn" href="/profil/kutuphanem">📚 Kütüphanem</a>
      <a class="btn ghost" href="/siparislerim">📦 Siparişlerim</a>
      <a class="btn ghost" href="/cikis" style="color:var(--muted)">Çıkış Yap</a>
    </div>
  </div>
</section>

<%- include('partials/footer') %>