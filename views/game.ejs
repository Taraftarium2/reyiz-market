<%- include('partials/header') %>

<section class="section">
  <div class="filters-bar">
    <input class="search-input" id="searchInput" type="text" placeholder="🔍  Oyun ara...">
    <div class="tags" id="tagFilters">
      <button class="chip active" data-tag="">Tümü</button>
      <% const tags = [...new Set(games.map(function(g){return g.tag;}).filter(Boolean))];
         tags.forEach(function(t) { %>
        <button class="chip" data-tag="<%= t %>"><%= t %></button>
      <% }); %>
    </div>
  </div>

  <div class="grid" id="gamesGrid">
    <% games.forEach(function (g) { %><%- include('partials/gamecard', { game: g }) %><% }) %>
  </div>
  <p class="empty" id="noResults" style="display:none">Sonuç bulunamadı.</p>
</section>

<script>
(function() {
  const input = document.getElementById('searchInput');
  const chips = document.querySelectorAll('#tagFilters .chip');
  const cards = document.querySelectorAll('#gamesGrid article');
  const noRes = document.getElementById('noResults');
  let activeTag = '';

  function filter() {
    const q = input.value.toLowerCase();
    let visible = 0;
    cards.forEach(function(c) {
      const title = (c.dataset.title || '').toLowerCase();
      const tag   = c.dataset.tag || '';
      const show  = title.includes(q) && (activeTag === '' || tag === activeTag);
      c.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    noRes.style.display = visible === 0 ? '' : 'none';
  }

  input.addEventListener('input', filter);
  chips.forEach(function(chip) {
    chip.addEventListener('click', function() {
      chips.forEach(function(c) { c.classList.remove('active'); });
      chip.classList.add('active');
      activeTag = chip.dataset.tag;
      filter();
    });
  });
})();
</script>

<%- include('partials/footer') %>
