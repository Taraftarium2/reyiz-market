const express = require('express');
const router = express.Router();
const db = require('../db');
const storage = require('../storage');
const { requireAuth } = require('../middlewares/auth');

// 1. Kütüphanem Sayfası
router.get('/profil/kutuphanem', requireAuth, async (req, res) => {
    try {
        const result = await db.query(
            `SELECT g.*, ul.purchased_at, ul.download_count
             FROM user_library ul 
             JOIN games g ON g.id = ul.game_id
             WHERE ul.user_id = $1 
             ORDER BY ul.purchased_at DESC`,
            [req.user.id]
        );

        const games = result.rows.map((g) => ({
            ...g,
            downloadUrl: storage.downloadUrl(g, req.protocol + '://' + req.get('host'))
        }));

        res.render('library', { games });
    } catch (err) {
        console.error(err);
        res.status(500).render('error', { message: 'Kütüphane yüklenirken bir hata oluştu.' });
    }
});

// 2. Güvenli İndirme Endpoint'i
router.get('/profil/kutuphanem/indir/:slug', requireAuth, async (req, res) => {
    const { slug } = req.params;

    try {
        // Kullanıcının bu ürünü satın alıp almadığını doğrula
        const result = await db.query(
            `SELECT g.*, ul.id as lib_id
             FROM user_library ul
             JOIN games g ON g.id = ul.game_id
             WHERE ul.user_id = $1 AND g.slug = $2`,
            [req.user.id, slug]
        );

        if (result.rows.length === 0) {
            return res.status(403).render('error', { 
                message: 'Bu ürünü indirmek için satın almanız veya siparişinizin onaylanması gerekmektedir.' 
            });
        }

        const game = result.rows[0];

        // İndirme sayısını artır
        await db.query(
            'UPDATE user_library SET download_count = download_count + 1 WHERE id = $1',
            [game.lib_id]
        );

        // Depolama servisinden dosya akışını alıp indir
        const fileStream = await storage.getFileStream(game.file_key);
        res.setHeader('Content-Disposition', `attachment; filename="${game.slug}.zip"`);
        fileStream.pipe(res);

    } catch (err) {
        console.error(err);
        res.status(500).render('error', { message: 'İndirme işlemi sırasında bir hata oluştu.' });
    }
});

module.exports = router;
