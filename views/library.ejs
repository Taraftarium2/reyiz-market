<%- include('partials/header') %>

<section class="section">
  <div class="section-title" style="text-align:left;margin-bottom:28px">
    <h2>📚 Kütüphanem</h2>
    <p>Satın aldığın oyunlar — dilediğin zaman indir</p>
  </div>
  <% if (!games.length) { %>
    <div class="empty">
      Henüz oyun satın almadın.<br>
      <a href="/oyunlar" style="margin-top:8px;display:inline-block">🎮 Mağazaya git →</a>
    </div>
  <% } else { %>
    <div class="lib-grid">
      <% games.forEach(function (g) { %>
        <div class="lib-card">
          <div class="lib-cover">
            <% if (g.cover_image_url) { %>
              <img src="<%= g.cover_image_url %>" alt="<%= g.title %>">
            <% } else { %>
              <div class="lib-cover-placeholder">🎮</div>
            <% } %>
          </div>
          <div class="lib-body">
            <h3><%= g.title %></h3>
            <p class="lib-meta">
              📥 <%= g.download_count %> indirme &nbsp;·&nbsp;
              <%= new Date(g.purchased_at).toLocaleDateString('tr-TR') %>
            </p>
            <a class="btn lib-dl" href="<%= g.downloadUrl %>">⬇ İndir (.zip)</a>
            <p class="note" style="margin-top:8px">🔗 Bağlantı 10 dk geçerlidir. Yeniden alabilirsin.</p>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</section>

<%- include('partials/footer') %>