<!-- views/library.ejs -->
<div class="library-container">
    <h2>Kütüphanem</h2>

    <% if (games && games.length > 0) { %>
        <div class="grid">
            <% games.forEach(function(game) { %>
                <div class="card">
                    <img src="<%= game.cover_image %>" alt="<%= game.title %>" />
                    <div class="card-body">
                        <h3><%= game.title %></h3>
                        <p>Satın Alma Tarihi: <%= new Date(game.purchased_at).toLocaleDateString('tr-TR') %></p>
                        
                        <!-- Tanımladığınız bağlantıya yönlendiren indirme butonu -->
                        <a href="<%= game.download_url %>" target="_blank" class="btn btn-success" style="padding: 10px 20px; background-color: #28a745; color: #fff; text-decoration: none; border-radius: 5px; font-weight: bold; display: inline-block;">
                            ⬇️ Dosyayı İndir
                        </a>
                    </div>
                </div>
            <% }); %>
        </div>
    <% } else { %>
        <p>Henüz satın aldığınız bir dosya bulunmuyor.</p>
    <% } %>
</div>
