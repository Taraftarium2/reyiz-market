<%- include('partials/header') %>

<div class="container section">
    <h1 class="page-title"><i class="fa-solid fa-folder-closed"></i> Oyun Kütüphanem</h1>

    <% if (libraryItems && libraryItems.length > 0) { %>
        <div class="library-grid">
            <% libraryItems.forEach(item => { %>
                <div class="library-card">
                    <img src="<%= item.cover_image %>" alt="<%= item.title %>" class="library-img">
                    <div class="library-info">
                        <h3><%= item.title %></h3>
                        <span class="genre-tag"><%= item.genre || 'Oyun' %></span>
                        <div class="key-box">
                            <label>Lisans Anahtarı:</label>
                            <code class="license-key"><%= item.license_key %></code>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
    <% } else { %>
        <div class="empty-state">
            <i class="fa-solid fa-box-open fa-3x"></i>
            <p>Kütüphanenizde henüz oyun bulunmuyor.</p>
            <a href="/games" class="btn btn-primary">Mağazaya Git</a>
        </div>
    <% } %>
</div>

<%- include('partials/footer') %>
