<%- include('partials/header') %>

<!-- HERO SECTION -->
<section class="hero" style="padding: 60px 20px 40px; text-align: center; position: relative;">
  <div class="hero-glow-1"></div>
  <div class="hero-glow-2"></div>
  <div class="hero-badge" style="display:inline-flex; align-items:center; gap:8px; padding:6px 16px; border-radius:30px; background:rgba(124,58,237,0.15); border:1px solid rgba(167,139,250,0.3); color:#c4b5fd; font-size:0.85rem; font-weight:700; margin-bottom:20px;">
    🔥 TikTok LIVE Canlı Yayın İnteraktif Oyun Pazarı
  </div>
  <h1 style="font-size: 2.8rem; font-weight: 900; line-height: 1.2; margin-bottom: 16px; letter-spacing: -0.02em;">
    Yayınını <span class="grad">Canlı Tut</span>, Chat & Hediyelerle <br>Kazancını 10'a Katla! 🚀
  </h1>
  <p class="hero-sub" style="max-width: 720px; margin: 0 auto 28px; font-size: 1.1rem; color: var(--muted); line-height: 1.6;">
    TikTok LIVE yayıncıları için özel olarak geliştirilmiş chat ve hediye etkileşimli interaktif oyun yazılımları. 
    Ödemeni yap, <b style="color:var(--text)">Kütüphanenden .ZIP dosyanı anında indir</b> ve yayınına başla!
  </p>

  <div class="cta" style="display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; margin-bottom: 32px;">
    <a class="btn big" href="/oyunlar" style="font-size: 1.05rem; padding: 14px 28px; border-radius: 12px; font-weight: 800; background: linear-gradient(135deg, #7c3aed, #ea580c); color: #fff;">🎮 Oyun Mağazasına Git →</a>
    <a class="btn big ghost" href="/rehber" style="font-size: 1.05rem; padding: 14px 28px; border-radius: 12px; font-weight: 700; border: 1px solid var(--border2); color: var(--text);">⚡ OBS Kurulum Rehberi</a>
  </div>

  <!-- HIGHLIGHT BADGES -->
  <div style="display: flex; gap: 20px; justify-content: center; flex-wrap: wrap; margin-bottom: 40px; font-size: 0.88rem; color: var(--muted);">
    <span style="display:flex; align-items:center; gap:6px;">⚡ <b>Anında .ZIP İndirme</b></span>
    <span style="display:flex; align-items:center; gap:6px;">🛡️ <b>%100 OBS & TikTok Studio Uyumlu</b></span>
    <span style="display:flex; align-items:center; gap:6px;">🎁 <b>Tek Seferlik Ödeme (Ömür Boyu)</b></span>
  </div>

  <!-- CANLI YAYIN SİMÜLATÖRÜ -->
  <div class="live-sim-wrap">
    <div class="live-sim-header">
      <div><span class="live-dot"></span>CANLI EKRAN SİMÜLATÖRÜ — TikTok Chat Entegrasyonu</div>
      <div style="color:var(--muted);font-size:.78rem">Gelen Hediye / Chat Tetikleyici</div>
    </div>
    <div class="live-sim-body">
      <div class="sim-screen">
        <div style="font-size:3.5rem;margin-bottom:8px">🎯</div>
        <div class="sim-screen-title">Hedef Vurma Oyunu (Canlı Şov)</div>
        <div class="sim-screen-sub">Tebrikler! @Ahmet Hedefi Vurdu 🎉 (+100 Puan)</div>
      </div>
      <div class="sim-chat">
        <div class="chat-msg">
          <span class="chat-user">@Mehmet:</span>
          <span class="chat-text">Sol üstteki hedefi vur!</span>
        </div>
        <div class="chat-msg">
          <span class="chat-user">@Zeynep:</span>
          <span class="gift-text">🎁 5x Rose gönderdi! (+5 Hızlandırıcı)</span>
        </div>
        <div class="chat-msg">
          <span class="chat-user">@Ahmet:</span>
          <span class="chat-text">BOMBA AT!</span>
        </div>
        <div class="chat-msg">
          <span class="chat-user">@Selin:</span>
          <span class="gift-text">🎁 1x ASA gönderdi! (Süper Güç)</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ISTATISTIK BARI -->
<div class="stats-bar">
  <div><b>50+</b><span>İnteraktif Oyun</span></div>
  <div><b>10.000+</b><span>Aktif Yayıncı</span></div>
  <div><b>24/7</b><span>Otomatik Teslimat</span></div>
  <div><b>%100</b><span>Süresiz Lisans</span></div>
</div>

<!-- 🚀 3 ADIMDA ÇALIŞMA MANTIĞI (SİSTEM NASIL ÇALIŞIR?) -->
<section class="section" id="nasil" style="padding: 50px 20px;">
  <div class="section-title" style="text-align: center; margin-bottom: 36px;">
    <h2 style="font-size: 2rem; font-weight: 800;">🚀 3 Kolay Adımda Canlı Yayına Başla</h2>
    <p style="color: var(--muted);">Karmaşık teknik işlemler yok — saniyeler içinde yayına hazır olursunuz</p>
  </div>

  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; max-width: 1050px; margin: 0 auto;">
    
    <div style="background: var(--card); border: 1px solid var(--border2); border-radius: 16px; padding: 28px; position: relative; text-align: left;">
      <div style="font-size: 2rem; font-weight: 900; color: #a78bfa; margin-bottom: 12px;">01.</div>
      <h3 style="font-size: 1.2rem; font-weight: 700; margin-bottom: 8px;">🎮 Oyununu Seç & İndir</h3>
      <p style="color: var(--muted); font-size: 0.92rem; line-height: 1.6;">
        Mağazadan dilediğin oyunu sepete ekle ve ödemeni tamamla. Dosya anında <b>Kütüphanem</b> sayfana tanımlanır ve `.zip` olarak bilgisayarına inersin.
      </p>
    </div>

    <div style="background: var(--card); border: 1px solid var(--border2); border-radius: 16px; padding: 28px; position: relative; text-align: left;">
      <div style="font-size: 2rem; font-weight: 900; color: #f97316; margin-bottom: 12px;">02.</div>
      <h3 style="font-size: 1.2rem; font-weight: 700; margin-bottom: 8px;">🛠️ OBS Studio'ya Ekle</h3>
      <p style="color: var(--muted); font-size: 0.92rem; line-height: 1.6;">
        İndirdiğin klasördeki `.env` dosyasına TikTok kullanıcı adını yaz ve `npm start` yap. OBS Studio'da <b>Tarayıcı Kaynağı (Browser Source)</b> olarak ekle.
      </p>
    </div>

    <div style="background: var(--card); border: 1px solid var(--border2); border-radius: 16px; padding: 28px; position: relative; text-align: left;">
      <div style="font-size: 2rem; font-weight: 900; color: #22c55e; margin-bottom: 12px;">03.</div>
      <h3 style="font-size: 1.2rem; font-weight: 700; margin-bottom: 8px;">🎁 Yayınını Başlat & Kazan</h3>
      <p style="color: var(--muted); font-size: 0.92rem; line-height: 1.6;">
        Canlı yayınını açtığında izleyicilerin attığı her hediye ve chat mesajı ekrandaki oyunu canlı olarak tetikler. İzlenme ve hediye patlamasını izle!
      </p>
    </div>

  </div>
</section>

<!-- ÖNE ÇIKAN OYUNLAR KATALOĞU -->
<section class="section" id="oyunlar">
  <div class="section-title">
    <h2>🔥 En Popüler Canlı Yayın Oyunları</h2>
    <p>TikTok LIVE yayıncılarının izlenme ve hediye rekorları kıran en popüler interaktif oyunları</p>
  </div>
  <div class="grid">
    <% if (typeof featured !== 'undefined' && featured && featured.length > 0) { %>
      <% featured.forEach(function (g) { %><%- include('partials/gamecard', { game: g }) %><% }) %>
    <% } else { %>
      <div class="empty" style="grid-column: 1 / -1;">Henüz oyun eklenmedi. Admin panelinden ilk oyunu ekleyin.</div>
    <% } %>
  </div>
  <div class="center" style="margin-top:36px">
    <a class="btn big ghost" href="/oyunlar">Tüm Oyun Kataloğunu Gör (50+ Oyun) →</a>
  </div>
</section>

<!-- SIKÇA SORULAN SORULAR -->
<section class="section">
  <div class="section-title">
    <h2>❓ Sıkça Sorulan Sorular</h2>
    <p>Aklınıza takılan tüm soruların cevapları</p>
  </div>
  <div class="faq-list">
    <div class="faq-item" onclick="this.classList.toggle('open')">
      <div class="faq-question">
        <span>Oyunları yayınımda nasıl çalıştırırım?</span>
        <span>▼</span>
      </div>
      <div class="faq-answer">Satın aldığınız oyun zip dosyasını indirip bilgisayarınızda çıkardıktan sonra .env dosyasına TikTok adınızı yazıp npm start yapın. OBS Studio -> Tarayıcı Kaynağı ekle diyerek yayına bağlayabilirsiniz.</div>
    </div>
    <div class="faq-item" onclick="this.classList.toggle('open')">
      <div class="faq-question">
        <span>Ödeme sonrası dosyalar ne zaman teslim edilir?</span>
        <span>▼</span>
      </div>
      <div class="faq-answer">Ödemeniz onaylandığı an oyun zip dosyası "Kütüphanem" sayfanıza otomatik tanımlanır. Tek tıkla doğrudan bilgisayarınıza indirebilirsiniz.</div>
    </div>
    <div class="faq-item" onclick="this.classList.toggle('open')">
      <div class="faq-question">
        <span>Satın aldığım oyunları tek seferlik mi ödüyorum?</span>
        <span>▼</span>
      </div>
      <div class="faq-answer">Evet! Reyiz Market'teki tüm oyunlar tek seferlik ödemelidir. Aylık veya yıllık abonelik ücreti yoktur. Ömür boyu sizindir.</div>
    </div>
  </div>
</section>

<!-- BOTTOM CTA BAND -->
<div class="cta-band">
  <h2>Yayınını Şimdiden Canlıya Taşı 🚀</h2>
  <p>Hemen üye ol, interaktif oyun kataloğunu incele ve yayınını büyüt!</p>
  <a class="btn big" href="/kayit">Ücretsiz Üye Ol — 30 Saniye</a>
</div>

<%- include('partials/footer') %>