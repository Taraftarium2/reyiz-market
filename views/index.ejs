<%- include('partials/header') %>

<section class="hero">
    <div class="container hero-content">
        <h1>Sınırsız Eğlence, En Uygun Fiyatlarla!</h1>
        <p>Binlerce dijital PC ve konsol oyununa anında sahip olun. Anında teslimat ve %100 orijinal lisans garantisi.</p>
        <a href="/games" class="btn btn-lg btn-primary"><i class="fa-solid fa-fire"></i> Mağazayı Keşfet</a>
    </div>
</section>

<section class="container section">
    <h2 class="section-title"><i class="fa-solid fa-star text-warning"></i> Öne Çıkan Oyunlar</h2>
    <div class="games-grid">
        <% if (featuredGames && featuredGames.length > 0) { %>
            <% featuredGames.forEach(game => { %>
                <%- include('partials/gamecard', { game: game }) %>
            <% }); %>
        <% } else { %>
            <p>Henüz öne çıkan oyun bulunmuyor.</p>
        <% } %>
    </div>
</section>

<section class="container section">
    <h2 class="section-title"><i class="fa-solid fa-clock-rotate-left text-info"></i> Son Eklenenler</h2>
    <div class="games-grid">
        <% if (latestGames && latestGames.length > 0) { %>
            <% latestGames.forEach(game => { %>
                <%- include('partials/gamecard', { game: game }) %>
            <% }); %>
        <% } else { %>
            <p>Henüz eklenmiş oyun bulunmuyor.</p>
        <% } %>
    </div>
</section>

<%- include('partials/footer') %>
