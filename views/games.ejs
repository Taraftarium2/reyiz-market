<%- include('partials/header') %>
<section class="section">
  <div class="sec-head">
    <h2>Oyun Kataloğu</h2>
    <span class="count"><%= games.length %> oyun</span>
  </div>
  <form class="filters" method="get" action="/oyunlar">
    <input type="text" name="q" placeholder="Oyun ara..." value="<%= q || '' %>">
    <div class="tags">
      <a class="chip <%= !tag ? 'active' : '' %>" href="/oyunlar?q=<%= q || '' %>">Tümü</a>
      <% tags.forEach(function (t) { %>
        <a class="chip <%= tag === t ? 'active' : '' %>" href="/oyunlar?q=<%= q || '' %>&tag=<%= encodeURIComponent(t) %>"><%= t %></a>
      <% }) %>
    </div>
  </form>
  <div class="grid">
    <% games.forEach(function (g) { %><%- include('partials/gamecard', { game: g }) %><% }) %>
    <% if (!games.length) { %>
      <div class="empty">
        <p>😕 Sonuç bulunamadı.</p>
        <a class="btn" href="/oyunlar">Tüm oyunları göster</a>
      </div>
    <% } %>
  </div>
</section>
<%- include('partials/footer') %>
