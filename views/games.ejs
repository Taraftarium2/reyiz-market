<%- include('partials/header') %>

<div class="container section">
    <h1 class="page-title">Oyun Mağazası</h1>

    <form action="/games" method="GET" class="filter-bar">
        <input type="text" name="search" placeholder="Oyun ara..." value="<%= currentSearch %>" class="form-input">
        
        <select name="genre" class="form-select">
            <option value="">Tüm Kategoriler</option>
            <% genres.forEach(g => { %>
                <option value="<%= g %>" <%= currentGenre === g ? 'selected' : '' %>><%= g %></option>
            <% }); %>
        </select>

        <select name="sort" class="form-select">
            <option value="">Sıralama</option>
            <option value="price_asc" <%= currentSort === 'price_asc' ? 'selected' : '' %>>Fiyat: Düşükten Yükseğe</option>
            <option value="price_desc" <%= currentSort === 'price_desc' ? 'selected' : '' %>>Fiyat: Yüksekten Düşüğe</option>
        </select>

        <button type="submit" class="btn btn-primary"><i class="fa-solid fa-filter"></i> Filtrele</button>
    </form>

    <div class="games-grid">
        <% if (games && games.length > 0) { %>
            <% games.forEach(game => { %>
                <%- include('partials/gamecard', { game: game }) %>
            <% }); %>
        <% } else { %>
            <p>Aradığınız kriterlere uygun oyun bulunamadı.</p>
        <% } %>
    </div>
</div>

<%- include('partials/footer') %>
