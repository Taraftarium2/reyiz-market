<%- include('partials/header') %>

<div class="success-wrap">
  <div class="success-box" style="border-color:rgba(239,68,68,.3);box-shadow:0 0 50px rgba(239,68,68,.06)">
    <div style="font-size:3rem;margin-bottom:16px"><%= status === 404 ? '🔍' : status === 403 ? '🚫' : '⚠️' %></div>
    <h2 style="color:var(--red)">Hata <%= status %></h2>
    <p><%= message %></p>
    <div class="success-btns">
      <a class="btn" href="/">Ana Sayfaya Dön</a>
    </div>
  </div>
</div>

<%- include('partials/footer') %>