<%- include('partials/header') %>
<section class="section">
  <h2>Admin Paneli</h2>
  <div class="admin-grid">
    <div class="panel">
      <h3>➕ Yeni Oyun Ekle</h3>
      <form method="post" action="/admin/oyun" enctype="multipart/form-data" class="form">
        <input name="title" placeholder="Oyun başlığı" required>
        <input name="slug" placeholder="slug (boş = otomatik)">
        <div class="row2">
          <input name="price" type="number" step="0.01" placeholder="Fiyat (₺)" required>
          <input name="tag" placeholder="Kategori">
        </div>
        <input name="cover_image_url" placeholder="Kapak görsel URL (opsiyonel)">
        <input name="node_version" placeholder="Node.js sürümü (örn 18)">
        <textarea name="description" placeholder="Açıklama — özellikler, nasıl oynanır"></textarea>
        <label class="check"><input type="checkbox" name="featured" value="1"> Ana sayfada öne çıkar</label>
        <label class="file">📦 Oyun zip dosyası (Node.js projesi)<input type="file" name="file" accept=".zip"></label>
        <button class="btn">Oyunu Ekle</button>
      </form>
      <div class="hint">
        <b>Zip içinde neler olmalı?</b> package.json + ana sunucu dosyan + README.md (npm install / npm start talimatları). Böylece alıcılar kurulumda takılmaz.
      </div>
    </div>
    <div>
      <div class="panel">
        <h3>🎮 Oyunlar</h3>
        <table class="tbl">
          <tr><th>Başlık</th><th>Kategori</th><th>Fiyat</th><th>Dosya</th><th></th></tr>
          <% games.forEach(function (g) { %>
          <tr>
            <td><%= g.title %></td>
            <td><%= g.tag %></td>
            <td>₺<%= Number(g.price).toFixed(0) %></td>
            <td class="mono"><%= g.file_key %></td>
            <td><form method="post" action="/admin/oyun/<%= g.id %>/sil"><button class="btn ghost sm">Sil</button></form></td>
          </tr>
          <% }) %>
        </table>
      </div>
      <div class="panel">
        <h3>🧾 Siparişler</h3>
        <table class="tbl">
          <tr><th>#</th><th>E-posta</th><th>Tutar</th><th>Durum</th><th>Ödeme</th></tr>
          <% orders.forEach(function (o) { %>
          <tr>
            <td><%= o.id %></td>
            <td><%= o.email %></td>
            <td>₺<%= Number(o.total_amount).toFixed(0) %></td>
            <td><span class="status <%= o.status %>"><%= o.status %></span></td>
            <td><%= o.payment_provider %></td>
          </tr>
          <% }) %>
        </table>
      </div>
    </div>
  </div>
</section>
<%- include('partials/footer') %>
