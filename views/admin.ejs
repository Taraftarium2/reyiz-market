<%- include('partials/header') %>

<div class="container section">
    <h1 class="page-title"><i class="fa-solid fa-shield-halved"></i> Yönetim Paneli</h1>

    <div class="stats-row">
        <div class="stat-card">
            <h3>Toplam Oyun</h3>
            <p class="stat-number"><%= stats.totalGames %></p>
        </div>
        <div class="stat-card">
            <h3>Toplam Sipariş</h3>
            <p class="stat-number"><%= stats.totalOrders %></p>
        </div>
    </div>

    <div class="admin-sections">
        <!-- Oyun Ekleme Formu -->
        <div class="admin-card">
            <h2>Yeni Oyun Ekle</h2>
            <form action="/admin/games/add" method="POST">
                <div class="form-group">
                    <label>Başlık</label>
                    <input type="text" name="title" class="form-input" required>
                </div>
                <div class="form-group">
                    <label>Açıklama</label>
                    <textarea name="description" class="form-input" rows="3"></textarea>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Fiyat (₺)</label>
                        <input type="number" step="0.01" name="price" class="form-input" required>
                    </div>
                    <div class="form-group">
                        <label>İndirimli Fiyat (₺)</label>
                        <input type="number" step="0.01" name="discount_price" class="form-input">
                    </div>
                </div>
                <div class="form-group">
                    <label>Görsel URL</label>
                    <input type="text" name="cover_image" class="form-input" placeholder="https://...">
                </div>
                <div class="form-group">
                    <label>Kategori (Tür)</label>
                    <input type="text" name="genre" class="form-input" placeholder="Aksiyon, RPG, Spor">
                </div>
                <div class="form-group">
                    <label><input type="checkbox" name="is_featured"> Öne Çıkarılan Oyun</label>
                </div>
                <button type="submit" class="btn btn-primary">Oyunu Kaydet</button>
            </form>
        </div>

        <!-- Key Ekleme Formu -->
        <div class="admin-card">
            <h2>Stok Lisans Key Ekle</h2>
            <form action="/admin/keys/add" method="POST">
                <div class="form-group">
                    <label>Oyun Seçin</label>
                    <select name="game_id" class="form-select" required>
                        <% games.forEach(g => { %>
                            <option value="<%= g.id %>"><%= g.title %></option>
                        <% }); %>
                    </select>
                </div>
                <div class="form-group">
                    <label>Lisans Anahtarı</label>
                    <input type="text" name="license_key" class="form-input" required placeholder="XXXX-YYYY-ZZZZ-1234">
                </div>
                <button type="submit" class="btn btn-success">Key Ekle</button>
            </form>
        </div>
    </div>

    <div class="admin-card mt-4">
        <h2>Mevcut Oyunlar</h2>
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Başlık</th>
                        <th>Kategori</th>
                        <th>Fiyat</th>
                        <th>İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    <% games.forEach(g => { %>
                        <tr>
                            <td>#<%= g.id %></td>
                            <td><%= g.title %></td>
                            <td><%= g.genre %></td>
                            <td>₺<%= parseFloat(g.price).toFixed(2) %></td>
                            <td>
                                <form action="/admin/games/delete/<%= g.id %>" method="POST" style="display:inline;">
                                    <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Silmek istediğinize emin misiniz?');">Sil</button>
                                </form>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
