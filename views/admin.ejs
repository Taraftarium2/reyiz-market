<%- include('partials/header') %>
<section class="section">
  <h2>⚙ Admin Paneli</h2>

  <!-- İstatistik Kartları -->
  <div class="stat-cards">
    <div class="stat-card">
      <div class="stat-icon">💰</div>
      <div class="stat-body">
        <div class="stat-value">₺<%= Number(stats.totalRevenue).toLocaleString('tr-TR', {minimumFractionDigits:0}) %></div>
        <div class="stat-label">Toplam Gelir</div>
      </div>
    </div>
    <div class="stat-card stat-card--warn">
      <div class="stat-icon">⏳</div>
      <div class="stat-body">
        <div class="stat-value"><%= stats.pendingCount %></div>
        <div class="stat-label">Bekleyen Sipariş</div>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon">👤</div>
      <div class="stat-body">
        <div class="stat-value"><%= stats.totalUsers %></div>
        <div class="stat-label">Kayıtlı Kullanıcı</div>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon">📦</div>
      <div class="stat-body">
        <div class="stat-value"><%= stats.totalOrders %></div>
        <div class="stat-label">Toplam Sipariş</div>
      </div>
    </div>
  </div>

  <div class="admin-grid">
    <!-- Oyun Ekle Formu -->
    <div>
      <h3>Oyun Ekle</h3>
      <form method="post" action="/admin/oyun" enctype="multipart/form-data" class="form">
        <input name="title" placeholder="Başlık" required>
        <input name="slug" placeholder="slug (boş = otomatik)">
        <input name="price" type="number" step="0.01" placeholder="Fiyat (₺)" required>
        <input name="cover_image_url" placeholder="Kapak görsel URL">
        <input name="node_version" placeholder="Node.js sürümü (örn 18)">
        <input name="tag" placeholder="Kategori">
        <textarea name="description" placeholder="Açıklama"></textarea>
        <label><input type="checkbox" name="featured" value="1"> Öne çıkan</label>
        <input type="file" name="file" accept=".zip">
        <button class="btn">Ekle</button>
      </form>
    </div>

    <!-- Oyunlar + Siparişler -->
    <div>
      <h3>Oyunlar (<%= games.length %>)</h3>
      <table class="tbl">
        <tr><th>Başlık</th><th>Fiyat</th><th>Kategori</th><th></th></tr>
        <% games.forEach(function (g) { %>
        <tr>
          <td><%= g.title %></td>
          <td>₺<%= Number(g.price).toFixed(0) %></td>
          <td><%= g.tag %></td>
          <td>
            <form method="post" action="/admin/oyun/<%= g.id %>/sil" style="display:inline">
              <button class="btn ghost sm">Sil</button>
            </form>
          </td>
        </tr>
        <% }) %>
      </table>

      <h3 style="margin-top:28px">
        Siparişler
        <% var pendingOrders = orders.filter(function(o){return o.status==='pending';}); %>
        <% if (pendingOrders.length > 0) { %>
          <span class="badge badge-pending" style="font-size:.8rem;margin-left:8px"><%= pendingOrders.length %> bekleyen</span>
        <% } %>
      </h3>
      <table class="tbl">
        <tr><th>#</th><th>Kullanıcı</th><th>Oyunlar</th><th>Tutar</th><th>Tarih</th><th>Durum</th><th>İşlem</th></tr>
        <% orders.forEach(function (o) { %>
        <tr class="<%= o.status === 'pending' ? 'tr-pending' : '' %>">
          <td><code><%= o.payment_ref || o.id %></code></td>
          <td>
            <div class="td-user">
              <span><%= o.email %></span>
            </div>
          </td>
          <td class="td-games">
            <% if (o.items && o.items[0] && o.items[0].title) { %>
              <% o.items.forEach(function(item){ %><span class="order-game-tag sm"><%= item.title %></span><% }); %>
            <% } %>
          </td>
          <td><strong>₺<%= Number(o.total_amount).toFixed(0) %></strong></td>
          <td class="muted td-date"><%= new Date(o.created_at).toLocaleDateString('tr-TR', {day:'2-digit', month:'2-digit', year:'numeric'}) %></td>
          <td>
            <% if (o.status === 'paid') { %>
              <span class="badge badge-paid">✓ Onaylandı</span>
            <% } else if (o.status === 'pending') { %>
              <span class="badge badge-pending">⏳ Bekliyor</span>
            <% } else if (o.status === 'cancelled') { %>
              <span class="badge badge-cancelled">✕ İptal</span>
            <% } else { %>
              <span class="badge"><%= o.status %></span>
            <% } %>
          </td>
          <td class="td-actions">
            <% if (o.status === 'pending') { %>
              <form method="post" action="/admin/siparis/<%= o.id %>/onayla" style="display:inline">
                <button class="btn sm btn-approve" onclick="return confirm('Bu siparişi onaylıyor musun? Kullanıcı kütüphanesine eklenecek.')">✓ Onayla</button>
              </form>
              <form method="post" action="/admin/siparis/<%= o.id %>/iptal" style="display:inline">
                <button class="btn ghost sm btn-cancel" onclick="return confirm('Bu siparişi iptal etmek istediğine emin misin?')">✕ İptal</button>
              </form>
            <% } %>
          </td>
        </tr>
        <% }) %>
      </table>
    </div>
  </div>
</section>
<%- include('partials/footer') %>
