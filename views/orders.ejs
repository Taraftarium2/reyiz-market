<%- include('partials/header') %>

<div class="container section">
    <h1 class="page-title"><i class="fa-solid fa-receipt"></i> Sipariş Geçmişim</h1>

    <% if (orders && orders.length > 0) { %>
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Sipariş No</th>
                        <th>Tarih</th>
                        <th>Oyun Sayısı</th>
                        <th>Toplam Tutar</th>
                        <th>Durum</th>
                    </tr>
                </thead>
                <tbody>
                    <% orders.forEach(o => { %>
                        <tr>
                            <td>#<%= o.id %></td>
                            <td><%= new Date(o.created_at).toLocaleDateString('tr-TR') %></td>
                            <td><%= o.item_count %> Adet</td>
                            <td>₺<%= parseFloat(o.total_amount).toFixed(2) %></td>
                            <td><span class="status-badge status-success"><%= o.status %></span></td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    <% } else { %>
        <div class="empty-state">
            <p>Henüz gerçekleşmiş bir siparişiniz yok.</p>
        </div>
    <% } %>
</div>

<%- include('partials/footer') %>
