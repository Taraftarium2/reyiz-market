<%- include('partials/header') %>
<section class="section">
  <h2>Siparişlerim</h2>
  <% if (!orders.length) { %>
    <p class="empty">Henüz hiç siparişin yok. <a href="/oyunlar">Mağazaya git</a>.</p>
  <% } else { %>
    <div class="orders-list">
      <% orders.forEach(function(o) { %>
      <div class="order-card">
        <div class="order-card-header">
          <div>
            <span class="order-ref">#<%= o.payment_ref %></span>
            <span class="order-date muted"><%= new Date(o.created_at).toLocaleDateString('tr-TR', { day:'2-digit', month:'long', year:'numeric', hour:'2-digit', minute:'2-digit' }) %></span>
          </div>
          <div class="order-right">
            <span class="order-amount">₺<%= Number(o.total_amount).toFixed(2) %></span>
            <% if (o.status === 'paid') { %>
              <span class="badge badge-paid">✓ Onaylandı</span>
            <% } else if (o.status === 'pending') { %>
              <span class="badge badge-pending">⏳ Beklemede</span>
            <% } else if (o.status === 'cancelled') { %>
              <span class="badge badge-cancelled">✕ İptal</span>
            <% } else { %>
              <span class="badge"><%= o.status %></span>
            <% } %>
          </div>
        </div>
        <div class="order-card-items">
          <% if (o.items && o.items[0] && o.items[0].title) { %>
            <% o.items.forEach(function(item) { %>
              <span class="order-game-tag"><%= item.title %></span>
            <% }) %>
          <% } %>
        </div>
        <div class="order-card-actions">
          <% if (o.status === 'pending') { %>
            <a class="btn ghost sm" href="/odeme/beklemede/<%= o.id %>">📋 Ödeme Bilgisi</a>
          <% } else if (o.status === 'paid') { %>
            <a class="btn sm" href="/profil/kutuphanem">⬇ Kütüphaneme Git</a>
          <% } %>
        </div>
      </div>
      <% }) %>
    </div>
  <% } %>
</section>
<%- include('partials/footer') %>
