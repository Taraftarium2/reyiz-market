<%- include('partials/header') %>

<div class="container section">
    <div class="auth-card">
        <h2>Giriş Yap</h2>
        <% if (registered) { %>
            <div class="alert alert-success">Kayıt başarılı! Lütfen giriş yapın.</div>
        <% } %>
        <% if (error) { %>
            <div class="alert alert-danger"><%= error %></div>
        <% } %>
        <form action="/auth/login" method="POST">
            <div class="form-group">
                <label>E-Posta Adresi</label>
                <input type="email" name="email" class="form-input" required placeholder="ornek@reyizmarket.com">
            </div>
            <div class="form-group">
                <label>Şifre</label>
                <input type="password" name="password" class="form-input" required placeholder="••••••••">
            </div>
            <button type="submit" class="btn btn-primary btn-block">Giriş Yap</button>
        </form>
        <p class="auth-footer">Hesabınız yok mu? <a href="/auth/register">Kayıt Ol</a></p>
    </div>
</div>

<%- include('partials/footer') %>
