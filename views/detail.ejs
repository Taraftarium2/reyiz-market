<%- include('partials/header') %>

<div class="container section">
    <div class="game-detail-wrapper">
        <div class="detail-media">
            <img src="<%= game.cover_image || 'https://images.unsplash.com/photo-1550745165-9bc0b252726f?auto=format&fit=crop&w=600&q=80' %>" alt="<%= game.title %>">
        </div>
        <div class="detail-info">
            <span class="genre-tag"><%= game.genre || 'Oyun' %></span>
            <h1><%= game.title %></h1>
            <p class="description"><%= game.description || 'Açıklama belirtilmemiş.' %></p>
            
            <div class="price-container">
                <% if (game.discount_price) { %>
                    <span class="old-price-lg">₺<%= parseFloat(game.price).toFixed(2) %></span>
                    <span class="current-price-lg">₺<%= parseFloat(game.discount_price).toFixed(2) %></span>
                <% } else { %>
                    <span class="current-price-lg">₺<%= parseFloat(game.price).toFixed(2) %></span>
                <% } %>
            </div>

            <form action="/checkout/add-to-cart" method="POST" class="add-to-cart-form">
                <input type="hidden" name="game_id" value="<%= game.id %>">
                <button type="submit" class="btn btn-lg btn-primary">
                    <i class="fa-solid fa-cart-plus"></i> Sepete Ekle
                </button>
            </form>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
