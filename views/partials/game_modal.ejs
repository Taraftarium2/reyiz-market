<!-- GLOBAL OYUN DETAY POPUP MODAL -->
<div id="gameDetailModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.82);backdrop-filter:blur(12px);z-index:9999;align-items:center;justify-content:center;padding:20px">
  <div style="background:var(--card);border:1px solid var(--border2);border-radius:24px;max-width:580px;width:100%;padding:28px;max-height:90vh;overflow-y:auto;box-shadow:var(--shadow);position:relative">
    
    <button onclick="closeGameModal()" style="position:absolute;top:18px;right:18px;background:var(--card3);border:1px solid var(--border2);border-radius:50%;width:36px;height:36px;color:var(--text);font-size:1.1rem;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:background .15s">✕</button>

    <div style="height:210px;border-radius:16px;overflow:hidden;margin-bottom:20px;position:relative;background:var(--card2)" id="modalCoverWrap">
      <img id="modalCover" src="" style="width:100%;height:100%;object-fit:cover;display:none">
      <div id="modalCoverPlaceholder" class="cover-placeholder" style="display:flex;height:100%;font-size:3.5rem">🎮</div>
      <span class="tag-chip" id="modalTag" style="position:absolute;top:12px;left:12px">Mini Oyun</span>
    </div>

    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px">
      <div class="rating-stars" style="font-size:1rem">★★★★★ <span class="rating-count">(4.9 / 5.0)</span></div>
      <span class="indirme-badge" id="modalNode">Node 18+</span>
    </div>

    <h2 id="modalTitle" style="font-size:1.8rem;font-weight:900;margin-bottom:10px;letter-spacing:-.02em">Oyun Başlığı</h2>

    <div style="margin-bottom:18px;display:flex;align-items:baseline;gap:10px">
      <span class="price big" id="modalPrice">₺149</span>
      <span style="color:var(--muted);font-size:.85rem">· Tek Seferlik Ödeme (Ömür Boyu Lisans)</span>
    </div>

    <p id="modalDesc" style="color:var(--muted);font-size:.92rem;line-height:1.65;margin-bottom:22px">Oyun açıklaması...</p>

    <div class="detail-reqs" style="margin-bottom:22px;border-color:var(--border)">
      <div class="req-item"><span>🚀 Platform:</span> TikTok LIVE & OBS Studio</div>
      <div class="req-item"><span>📥 Teslimat:</span> Otomatik Kütüphanem İndirmesi (.zip)</div>
    </div>

    <a id="modalExternalBtn" class="btn big success-btn" href="#" target="_blank" style="display:none;width:100%;margin-bottom:12px">🛍️ İtemSatış / Kredi Kartı İle Satın Al ➔</a>

    <div style="display:flex;gap:12px;flex-wrap:wrap">
      <form id="modalCartForm" method="post" action="/sepet/ekle" style="flex:1">
        <input type="hidden" name="game_id" id="modalGameId" value="">
        <button class="btn big" type="submit" style="width:100%;padding:14px">🛒 Sepete Ekle</button>
      </form>
      <a id="modalDirectLink" class="btn big ghost" href="#">Sayfa Linki 🔗</a>
    </div>

  </div>
</div>

<script>
function openGameModal(game) {
  document.getElementById('modalGameId').value = game.id;
  document.getElementById('modalTitle').textContent = game.title || 'Oyun Detayı';
  document.getElementById('modalPrice').textContent = '₺' + Number(game.price || 0).toFixed(0);
  document.getElementById('modalTag').textContent = game.tag || 'Mini Oyun';
  document.getElementById('modalNode').textContent = 'Node ' + (game.node_version || '18+');
  document.getElementById('modalDesc').textContent = game.description || 'Bu interaktif oyun canlı yayınlarınızda chat etkileşimini ve hediye katılımını artırmak için tasarlanmıştır.';
  document.getElementById('modalDirectLink').href = '/oyunlar/' + (game.slug || '');

  var extBtn = document.getElementById('modalExternalBtn');
  if (game.external_buy_url && String(game.external_buy_url).trim() !== '') {
    extBtn.href = game.external_buy_url;
    extBtn.style.display = 'inline-flex';
  } else {
    extBtn.style.display = 'none';
  }

  var img = document.getElementById('modalCover');
  var ph = document.getElementById('modalCoverPlaceholder');
  if (game.cover_image_url && String(game.cover_image_url).trim() !== '') {
    img.src = game.cover_image_url;
    img.style.display = 'block';
    ph.style.display = 'none';
  } else {
    img.style.display = 'none';
    ph.style.display = 'flex';
  }

  document.getElementById('gameDetailModal').style.display = 'flex';
}
function closeGameModal() {
  document.getElementById('gameDetailModal').style.display = 'none';
}
document.getElementById('gameDetailModal')?.addEventListener('click', function(e) {
  if (e.target === this) closeGameModal();
});
</script>
