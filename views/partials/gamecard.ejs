<div class="game-card">
    <div class="card-img-wrapper">
        <img src="<%= game.cover_image || 'https://images.unsplash.com/photo-1550745165-9bc0b252726f?auto=format&fit=crop&w=600&q=80' %>" alt="<%= game.title %>">
        <% if (game.discount_price) { %>
            <span class="discount-badge">-%<%= Math.round(((game.price - game.discount_price) / game.price) * 100) %></span>
        <% } %>
    </div>
    <div class="card-body">
        <span class="genre-tag"><%= game.genre || 'Oyun' %></span>
        <h3 class="game-title"><a href="/games/<%= game.slug %>"><%= game.title %></a></h3>
        <div class="card-footer">
            <div class="price-box">
                <% if (game.discount_price) { %>
                    <span class="old-price">₺<%= parseFloat(game.price).toFixed(2) %></span>
                    <span class="current-price">₺<%= parseFloat(game.discount_price).toFixed(2) %></span>
                <% } else { %>
                    <span class="current-price">₺<%= parseFloat(game.price).toFixed(2) %></span>
                <% } %>
            </div>
            <form action="/checkout/add-to-cart" method="POST">
                <input type="hidden" name="game_id" value="<%= game.id %>">
                <button type="submit" class="btn btn-sm btn-primary">
                    <i class="fa-solid fa-cart-plus"></i> Ekle
                </button>
            </form>
        </div>
    </div>
</div>
