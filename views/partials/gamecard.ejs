<article class="card">
  <div class="cover" style="background:<%= game.cover_image_url || 'linear-gradient(135deg,#8b5cf6,#f97316)' %>">
    <% if (game.cover_image_url) { %><img src="<%= game.cover_image_url %>" alt=""><% } %>
    <span class="tag"><%= game.tag %></span>
    <% if (game.featured) { %><span class="badge hot">🔥 Popüler</span><% } %>
  </div>
  <div class="card-body">
    <h3><a href="/oyunlar/<%= game.slug %>"><%= game.title %></a></h3>
    <p><%= (game.description || '').slice(0, 90) %></p>
    <div class="row">
      <span class="price">₺<%= Number(game.price).toFixed(0) %></span>
      <form method="post" action="/sepet/ekle">
        <input type="hidden" name="game_id" value="<%= game.id %>">
        <button class="btn sm">Sepete Ekle</button>
      </form>
    </div>
  </div>
</article>
