<article class="card" data-title="<%= game.title.toLowerCase() %>" data-tag="<%= game.tag || '' %>" style="border: 1px solid var(--border2); border-radius: 16px; overflow: hidden; background: var(--card); transition: transform 0.2s, box-shadow 0.2s; display: flex; flex-direction: column;">
  <div class="cover" onclick="openGameModal(<%= JSON.stringify(game) %>)" style="cursor:pointer; position: relative; height: 180px; overflow: hidden;" title="Detayları pop-up ile gör">
    <% if (game.cover_image_url) { %>
      <img src="<%= game.cover_image_url %>" alt="<%= game.title %>" style="width: 100%; height: 100%; object-fit: cover;">
    <% } else { %>
      <div class="cover-placeholder" style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 3rem; background: linear-gradient(135deg, var(--purple), var(--orange));">🎮</div>
    <% } %>
    
    <span class="tag-chip" style="position: absolute; top: 12px; left: 12px; background: rgba(0,0,0,0.7); backdrop-filter: blur(8px); color: #fff; padding: 4px 10px; border-radius: 20px; font-size: 0.75rem; font-weight: 700;">
      <%= game.tag || 'Mini Oyun' %>
    </span>

    <% if (game.featured) { %>
      <span class="featured-chip" style="position: absolute; top: 12px; right: 12px; background: linear-gradient(90deg, #ea580c, #ef4444); color: #fff; padding: 4px 10px; border-radius: 20px; font-size: 0.75rem; font-weight: 800; box-shadow: 0 0 10px rgba(234,88,12,0.4);">
        🔥 ÇOK SATAN
      </span>
    <% } %>
  </div>

  <div class="card-body" style="padding: 18px; display: flex; flex-direction: column; flex: 1; justify-content: space-between;">
    <div>
      <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:8px;">
        <div style="color: #fbbf24; font-size: 0.85rem; font-weight: 700;">★★★★★ <span style="color:var(--muted); font-size:0.78rem;">(4.9)</span></div>
        <span style="background: rgba(34,197,94,0.12); color: #4ade80; border: 1px solid rgba(34,197,94,0.3); padding: 2px 8px; border-radius: 6px; font-size: 0.72rem; font-weight: 700;">
          ⚡ %100 OBS Uyumlu
        </span>
      </div>

      <h3 onclick="openGameModal(<%= JSON.stringify(game) %>)" style="cursor:pointer; font-size: 1.15rem; font-weight: 800; margin-bottom: 8px; line-height: 1.3;" title="Detayları pop-up ile gör">
        <%= game.title %>
      </h3>
      <p style="color: var(--muted); font-size: 0.86rem; line-height: 1.5; margin-bottom: 16px;">
        <%= (game.description || '').slice(0, 80) %><% if ((game.description||'').length > 80) { %>…<% } %>
      </p>
    </div>

    <div class="card-foot" style="display: flex; align-items: center; justify-content: space-between; gap: 10px; border-top: 1px solid var(--border); padding-top: 14px; margin-top: auto;">
      <div>
        <span style="font-size: 1.3rem; font-weight: 900; color: #fff;">₺<%= Number(game.price).toFixed(0) %></span>
      </div>
      <div style="display:flex; gap:8px; align-items:center;">
        <button class="btn ghost sm" type="button" onclick="openGameModal(<%= JSON.stringify(game) %>)" style="padding: 8px 12px; font-size: 0.82rem; border-radius: 8px; font-weight: 700;">
          İncele 👁️
        </button>
        <form method="post" action="/sepet/ekle" style="margin:0;">
          <input type="hidden" name="game_id" value="<%= game.id %>">
          <button class="btn sm" style="padding: 8px 14px; font-size: 0.82rem; border-radius: 8px; font-weight: 800; background: linear-gradient(135deg, var(--purple), var(--orange)); color: #fff;">
            + Sepet
          </button>
        </form>
      </div>
    </div>
  </div>
</article>