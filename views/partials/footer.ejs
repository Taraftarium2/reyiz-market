<!-- GLOBAL SEPETE EKLEME & UÇAN PARÇACIK ANİMASYON SCRIPT'I -->
<script>
(function() {
  document.addEventListener('submit', function(e) {
    var form = e.target;
    if (form && form.getAttribute('action') === '/sepet/ekle') {
      e.preventDefault();
      var btn = form.querySelector('button[type="submit"]') || form.querySelector('button');
      var origText = btn ? btn.innerHTML : '';
      var gameIdInput = form.querySelector('input[name="game_id"]');
      var gameId = gameIdInput ? gameIdInput.value : '';

      // Buton başarı durumu ve yeşil parıltı
      if (btn) {
        btn.classList.add('btn-added');
        btn.innerHTML = '✓ Sepete Eklendi!';
      }

      // AJAX isteği ile sepete ekle
      fetch('/sepet/ekle', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/x-www-form-urlencoded',
          'X-Requested-With': 'XMLHttpRequest',
          'Accept': 'application/json'
        },
        body: 'game_id=' + encodeURIComponent(gameId)
      })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        if (data && data.success) {
          // Navbardaki sepet sayacını güncelle & zıplat
          var counter = document.getElementById('navCartCount');
          if (counter) {
            counter.textContent = data.count;
            counter.classList.remove('bump');
            void counter.offsetWidth;
            counter.classList.add('bump');
          }

          // Uçan +1 🛒 parçacık animasyonu
          if (btn) {
            var rect = btn.getBoundingClientRect();
            var p = document.createElement('div');
            p.className = 'cart-fly-particle';
            p.textContent = '+1 🛒';
            p.style.left = (rect.left + rect.width / 2) + 'px';
            p.style.top = rect.top + 'px';
            
            var navCart = document.getElementById('navCartBadge');
            var targetX = '0px', targetY = '-120px';
            if (navCart) {
              var navRect = navCart.getBoundingClientRect();
              targetX = (navRect.left - rect.left) + 'px';
              targetY = (navRect.top - rect.top) + 'px';
            }
            p.style.setProperty('--fly-x', targetX);
            p.style.setProperty('--fly-y', targetY);

            document.body.appendChild(p);
            setTimeout(function() { p.remove(); }, 750);
          }
        }
      })
      .catch(function(err) { console.error('Sepete ekleme hatası:', err); });

      // 2.2 saniye sonra butonu eski haline çevir
      setTimeout(function() {
        if (btn) {
          btn.classList.remove('btn-added');
          btn.innerHTML = origText;
        }
      }, 2200);
    }
  });
})();
</script>
</body>
</html>