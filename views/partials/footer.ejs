<!-- CANLI SATIŞ BİLDİRİMİ POP-UP SCRIPT'I (SOCIAL PROOF) -->
<script>
(function() {
  var salesData = [];
  var index = 0;

  function showNextToast() {
    if (!salesData.length) return;
    var item = salesData[index % salesData.length];
    index++;

    var toast = document.createElement('div');
    toast.className = 'sales-toast';
    toast.innerHTML = 
      '<div class="sales-toast-avatar">⚡</div>' +
      '<div>' +
        '<div><strong style="color:var(--purple2)">' + item.name + '</strong> az önce satın aldı:</div>' +
        '<div style="font-weight:700;color:var(--text)">' + item.game + ' <span style="font-size:.75rem;color:var(--muted)">(' + item.time + ')</span></div>' +
      '</div>';

    document.body.appendChild(toast);

    setTimeout(function() {
      toast.style.transition = 'opacity .5s ease, transform .5s ease';
      toast.style.opacity = '0';
      toast.style.transform = 'translateY(20px)';
      setTimeout(function() { toast.remove(); }, 500);
    }, 4500);
  }

  fetch('/api/recent-sales')
    .then(function(r) { return r.json(); })
    .then(function(data) {
      if (data && data.length) {
        salesData = data;
        setTimeout(showNextToast, 4000);
        setInterval(showNextToast, 12000);
      }
    })
    .catch(function(e) {});
})();
</script>
