<!-- CANLI SATIŞ BİLDİRİMİ POP-UP SCRIPT'I (SOCIAL PROOF) -->
<script>
(function() {
  var salesData = [];
  var index = 0;

  function showNextToast() {
    if (!salesData.length) return;
    var item = salesData[index % salesData.length];
    index++;

    var toast = document.createElement('div');
    toast.className = 'sales-toast';

    var avatar = document.createElement('div');
    avatar.className = 'sales-toast-avatar';
    avatar.textContent = '⚡';

    var body = document.createElement('div');
    var line1 = document.createElement('div');
    var strong = document.createElement('strong');
    strong.style.color = 'var(--purple2)';
    strong.textContent = item.name || '';
    line1.appendChild(strong);
    line1.appendChild(document.createTextNode(' az önce satın aldı:'));
    var line2 = document.createElement('div');
    line2.style.fontWeight = '700';
    line2.style.color = 'var(--text)';
    line2.textContent = (item.game || '') + ' ';
    var timeSpan = document.createElement('span');
    timeSpan.style.fontSize = '.75rem';
    timeSpan.style.color = 'var(--muted)';
    timeSpan.textContent = '(' + (item.time || '') + ')';
    line2.appendChild(timeSpan);
    body.appendChild(line1);
    body.appendChild(line2);

    toast.appendChild(avatar);
    toast.appendChild(body);
    document.body.appendChild(toast);

    setTimeout(function() {
      toast.style.transition = 'opacity .5s ease, transform .5s ease';
      toast.style.opacity = '0';
      toast.style.transform = 'translateY(20px)';
      setTimeout(function() { toast.remove(); }, 500);
    }, 4500);
  }

  fetch('/api/recent-sales')
    .then(function(r) { return r.json(); })
    .then(function(data) {
      if (data && data.length) {
        salesData = data;
        setTimeout(showNextToast, 4000);
        setInterval(showNextToast, 12000);
      }
    })
    .catch(function(e) {});
})();
</script>
