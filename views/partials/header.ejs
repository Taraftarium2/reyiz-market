<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reyiz Market - Dijital Oyun Mağazası</title>
    <link rel="stylesheet" href="/styles.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    <header class="navbar">
        <div class="container nav-container">
            <a href="/" class="brand">
                <i class="fa-solid fa-gamepad brand-icon"></i>
                <span class="brand-text">REYIZ<span class="highlight">MARKET</span></span>
            </a>

            <nav class="nav-links">
                <a href="/"><i class="fa-solid fa-house"></i> Anasayfa</a>
                <a href="/games"><i class="fa-solid fa-store"></i> Mağaza</a>
                <% if (user) { %>
                    <a href="/library"><i class="fa-solid fa-folder-closed"></i> Kütüphanem</a>
                    <a href="/orders"><i class="fa-solid fa-receipt"></i> Siparişlerim</a>
                    <% if (user.role === 'admin') { %>
                        <a href="/admin" class="admin-badge"><i class="fa-solid fa-shield-halved"></i> Admin Panel</a>
                    <% } %>
                <% } %>
            </nav>

            <div class="nav-actions">
                <a href="/checkout/cart" class="cart-btn">
                    <i class="fa-solid fa-cart-shopping"></i>
                    <span class="cart-count"><%= cart ? cart.length : 0 %></span>
                </a>

                <% if (user) { %>
                    <div class="user-menu">
                        <a href="/auth/profile" class="user-profile-btn">
                            <i class="fa-solid fa-circle-user"></i> <%= user.username %>
                        </a>
                        <a href="/auth/logout" class="logout-btn" title="Çıkış Yap">
                            <i class="fa-solid fa-right-from-bracket"></i>
                        </a>
                    </div>
                <% } else { %>
                    <a href="/auth/login" class="btn btn-outline">Giriş Yap</a>
                    <a href="/auth/register" class="btn btn-primary">Kayıt Ol</a>
                <% } %>
            </div>
        </div>
    </header>
    <main class="main-content">
