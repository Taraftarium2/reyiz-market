<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
  <meta name="theme-color" content="#080810">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  
  <!-- Primary SEO -->
  <title><%= title %> · Reyiz Market</title>
  <meta name="title" content="<%= title %> · Reyiz Market">
  <meta name="description" content="Reyiz Market — TikTok LIVE yayıncıları için Node.js tabanlı, chat ve hediye etkileşimli dijital oyun pazarı. Anında indirme, %100 canlı yayın uyumlu.">
  <meta name="keywords" content="tiktok live oyunları, tiktok canlı yayın oyunu, nodejs tiktok botu, interaktif yayın oyunları, reyiz market, canlı yayın hediye oyunu">
  <meta name="robots" content="index, follow">
  <link rel="canonical" href="https://reyizmarket.click/">

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://reyizmarket.click/">
  <meta property="og:title" content="<%= title %> · Reyiz Market">
  <meta property="og:description" content="TikTok LIVE yayıncıları için interaktif oyun pazarı. Satın al, Kütüphanenden tek tıkla indir ve yayınını canlıya taşı!">
  <meta property="og:image" content="https://reyizmarket.click/og-image.jpg">

  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image">
  <meta property="twitter:url" content="https://reyizmarket.click/">
  <meta property="twitter:title" content="<%= title %> · Reyiz Market">
  <meta property="twitter:description" content="TikTok LIVE yayıncıları için interaktif oyun pazarı. Satın al, Kütüphanenden tek tıkla indir ve yayınını canlıya taşı!">

  <!-- Schema.org JSON-LD (Google Rich Snippet) -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "Reyiz Market - TikTok LIVE Oyunları",
    "operatingSystem": "Windows, macOS, Linux, Node.js",
    "applicationCategory": "GameApplication",
    "ratingValue": "4.9",
    "ratingCount": "1250",
    "offers": {
      "@type": "Offer",
      "price": "99.00",
      "priceCurrency": "TRY"
    }
  }
  </script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <!-- CSS Cache Buster v2.1.0 -> Normal penceredeki eski önbelleği anında temizler -->
  <link rel="stylesheet" href="/styles.css?v=2.1.0">
</head>
<body>
<header class="nav">
  <a class="logo" href="/">
    <span class="logo-icon">⚡</span>
    Reyiz<span>Market</span>
  </a>
  <button class="burger" id="burgerBtn" aria-label="Menüyü Aç/Kapat">☰</button>
  <nav class="links" id="navLinks">
    <a href="/oyunlar">🎮 Oyunlar</a>
    <a href="/sepet">🛒 (<%= cartCount %>)</a>
    <% if (user) { %>
      <a href="/siparislerim">📦 Siparişlerim</a>
      <a href="/profil/kutuphanem">📚 Kütüphanem</a>
      <a href="/profil">👤 Profil</a>
      <% if (user.role === 'admin') { %><a href="/admin" class="btn sm">⚙ Admin</a><% } %>
      <a href="/cikis" style="color:var(--muted)">Çıkış</a>
    <% } else { %>
      <a href="/giris">Giriş Yap</a>
      <a class="btn" href="/kayit">Üye Ol</a>
    <% } %>
  </nav>
</header>
<main>
<script>
  (function() {
    var btn = document.getElementById('burgerBtn');
    if (btn) {
      btn.addEventListener('click', function(e) {
        e.stopPropagation();
        document.body.classList.toggle('menu-open');
      });
      document.addEventListener('click', function(e) {
        if (!e.target.closest('.nav')) {
          document.body.classList.remove('menu-open');
        }
      });
    }
  })();
</script>