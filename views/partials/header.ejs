<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · Reyiz Market</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
<header class="nav">
  <a class="logo" href="/">⚡ Reyiz<span>Market</span></a>
