<%- include('partials/header') %>

<section class="section">
  <div class="section-title" style="text-align:left;margin-bottom:24px">
    <h2>🛒 Sepetim</h2>
    <p>Seçtiğiniz interaktif oyunlar ve sipariş özeti</p>
  </div>

  <% if (!items || !items.length) { %>
    <div class="empty">
      <div style="font-size:3rem;margin-bottom:12px">🛒</div>
      <h3 style="font-size:1.2rem;font-weight:700;margin-bottom:6px">Sepetiniz Boş</h3>
      <p style="color:var(--muted);font-size:.9rem;margin-bottom:18px">Katalogdan oyunları keşfedip sepete ekleyin.</p>
      <a class="btn big" href="/oyunlar">🎮 Oyun Mağazasına Git →</a>
    </div>
  <% } else { %>
    <div style="display:grid;grid-template-columns:1fr 340px;gap:24px;align-items:start">
      
      <!-- Sol: Ürün Listesi -->
      <div class="cartlist">
        <% items.forEach(function (g) { %>
          <div class="cartrow" style="background:var(--card);border:1px solid var(--border);border-radius:14px;padding:16px 20px;margin-bottom:12px">
            <div style="display:flex;align-items:center;gap:14px">
              <div style="width:50px;height:50px;border-radius:10px;overflow:hidden;background:var(--card2);display:flex;align-items:center;justify-content:center;font-size:1.5rem">
                <% if (g.cover_image_url) { %>
                  <img src="<%= g.cover_image_url %>" style="width:100%;height:100%;object-fit:cover">
                <% } else { %>
                  🎮
                <% } %>
              </div>
              <div>
                <div class="cartrow-name" style="font-weight:700;font-size:1rem"><%= g.title %></div>
                <div style="font-size:.8rem;color:var(--purple2)"><%= g.tag || 'Mini Oyun' %> · Node <%= g.node_version || '18+' %></div>
              </div>
            </div>

            <div style="display:flex;align-items:center;gap:16px">
              <span class="price" style="font-size:1.1rem;font-weight:800;color:var(--orange2)">₺<%= Number(g.price).toFixed(0) %></span>
              <form method="post" action="/sepet/sil/<%= g.id %>" style="margin:0">
                <button class="btn ghost sm" style="color:var(--muted);padding:6px 10px" title="Kaldır">✕</button>
              </form>
            </div>
          </div>
        <% }) %>
      </div>

      <!-- Sağ: İndirim Kuponu & Sipariş Özeti -->
      <div>
        <!-- Kupon Formu -->
        <div style="background:var(--card);border:1px solid var(--border);border-radius:16px;padding:20px;margin-bottom:16px">
          <div style="font-weight:700;font-size:.95rem;margin-bottom:10px">🎟️ İndirim Kuponu</div>
          
          <% if (typeof couponError !== 'undefined' && couponError) { %>
            <div class="alert" style="padding:8px 12px;font-size:.82rem;margin-bottom:10px"><%= couponError %></div>
          <% } %>

          <% if (typeof coupon !== 'undefined' && coupon) { %>
            <div style="display:flex;align-items:center;justify-content:space-between;background:rgba(74,222,128,.1);border:1px dashed #4ade80;padding:10px 14px;border-radius:10px;color:#4ade80;font-weight:700;font-size:.88rem">
              <div>
                <span>✓ <%= coupon.code %></span>
                <span style="font-size:.78rem;font-weight:400;display:block">
                  <%= coupon.discount_percent > 0 ? ('%' + coupon.discount_percent + ' İndirim') : ('₺' + coupon.discount_amount + ' İndirim') %>
                </span>
              </div>
              <form method="post" action="/sepet/kupon/kaldir" style="margin:0">
                <button class="btn ghost sm" style="color:#f43f5e;padding:2px 8px">✕ Kaldır</button>
              </form>
            </div>
          <% } else { %>
            <form method="post" action="/sepet/kupon" style="display:flex;gap:8px">
              <input name="code" placeholder="Örn: TIKTOK20" style="text-transform:uppercase;font-weight:700" required>
              <button class="btn sm" type="submit">Uygula</button>
            </form>
            <div style="font-size:.75rem;color:var(--muted);margin-top:6px">💡 İpucu: <strong>TIKTOK20</strong> kodu ile %20 indirim kazanın!</div>
          <% } %>
        </div>

        <!-- Ödeme Özeti Koyu Kutu -->
        <div style="background:var(--card2);border:1px solid var(--border2);border-radius:16px;padding:22px">
          <h3 style="font-size:1.1rem;font-weight:800;margin-bottom:16px">Sipariş Özeti</h3>
          
          <div style="display:flex;justify-content:space-between;font-size:.9rem;color:var(--muted);margin-bottom:8px">
            <span>Ara Toplam</span>
            <span>₺<%= Number(subtotal).toFixed(0) %></span>
          </div>

          <% if (typeof discount !== 'undefined' && discount > 0) { %>
            <div style="display:flex;justify-content:space-between;font-size:.9rem;color:#4ade80;font-weight:700;margin-bottom:8px">
              <span>Kupon İndirimi</span>
              <span>- ₺<%= Number(discount).toFixed(0) %></span>
            </div>
          <% } %>

          <div style="display:flex;justify-content:space-between;font-size:1.3rem;font-weight:900;color:var(--text);border-top:1px solid var(--border);padding-top:14px;margin-top:10px">
            <span>Genel Toplam</span>
            <span style="color:var(--orange2)">₺<%= Number(total).toFixed(0) %></span>
          </div>

          <a class="btn big" href="/odeme" style="width:100%;margin-top:20px;text-align:center">Ödemeye Geç →</a>
          <a class="btn ghost" href="/oyunlar" style="width:100%;margin-top:8px;text-align:center;font-size:.85rem">Alışverişe Devam Et</a>
        </div>
      </div>

    </div>
  <% } %>
</section>

<%- include('partials/footer') %>