<%- include('partials/header') %>

<div class="container section">
    <h1 class="page-title"><i class="fa-solid fa-cart-shopping"></i> Alışveriş Sepeti</h1>

    <% if (cart && cart.length > 0) { %>
        <div class="cart-layout">
            <div class="cart-items">
                <% cart.forEach(item => { %>
                    <div class="cart-item">
                        <img src="<%= item.cover_image %>" alt="<%= item.title %>" class="cart-item-img">
                        <div class="cart-item-info">
                            <h3><%= item.title %></h3>
                            <p class="cart-item-price">₺<%= (item.discount_price || item.price).toFixed(2) %></p>
                        </div>
                        <form action="/checkout/remove" method="POST">
                            <input type="hidden" name="game_id" value="<%= item.id %>">
                            <button type="submit" class="btn btn-sm btn-danger"><i class="fa-solid fa-trash"></i></button>
                        </form>
                    </div>
                <% }); %>
            </div>

            <div class="cart-summary">
                <h3>Sipariş Özeti</h3>
                <div class="summary-row">
                    <span>Toplam Tutar:</span>
                    <strong>₺<%= total.toFixed(2) %></strong>
                </div>
                <a href="/checkout/process" class="btn btn-lg btn-success btn-block">Ödemeye Geç <i class="fa-solid fa-arrow-right"></i></a>
            </div>
        </div>
    <% } else { %>
        <div class="empty-state">
            <i class="fa-solid fa-cart-flatbed fa-3x"></i>
            <p>Sepetinizde henüz oyun bulunmuyor.</p>
            <a href="/games" class="btn btn-primary">Oyunlara Göz At</a>
        </div>
    <% } %>
</div>

<%- include('partials/footer') %>
