<%- include('partials/header') %>

<section class="section">
  <h2 style="margin-bottom:24px">🛒 Sepetim</h2>
  <% if (!items.length) { %>
    <div class="empty">Sepetin boş. <a href="/oyunlar">Oyunlara göz at →</a></div>
  <% } else { %>
    <div class="cartlist" style="max-width:640px">
      <% items.forEach(function (g) { %>
        <div class="cartrow">
          <div>
            <div class="cartrow-name"><%= g.title %></div>
            <div style="font-size:.8rem;color:var(--muted)"><%= g.tag %></div>
          </div>
          <div style="display:flex;align-items:center;gap:14px">
            <span class="price" style="font-size:1rem">₺<%= Number(g.price).toFixed(0) %></span>
            <form method="post" action="/sepet/sil/<%= g.id %>">
              <button class="btn ghost sm" style="color:var(--muted)">✕ Kaldır</button>
            </form>
          </div>
        </div>
      <% }) %>
    </div>
    <div class="total-row-wrap" style="max-width:640px;margin-top:14px">
      <span class="total-label">Toplam</span>
      <span class="total-val">₺<%= total.toFixed(0) %></span>
    </div>
    <div style="margin-top:18px;display:flex;gap:12px;flex-wrap:wrap">
      <a class="btn big" href="/odeme">Ödemeye Geç →</a>
      <a class="btn ghost" href="/oyunlar">Alışverişe Devam</a>
    </div>
  <% } %>
</section>

<%- include('partials/footer') %>