<%- include('partials/header') %>

<div class="container section">
    <h1 class="page-title"><i class="fa-solid fa-credit-card"></i> Ödeme İşlemi</h1>

    <% if (error) { %>
        <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <div class="checkout-layout">
        <form action="/checkout/complete" method="POST" class="checkout-form">
            <h3>Kart Bilgileri</h3>
            <div class="form-group">
                <label>Kart Üzerindeki İsim</label>
                <input type="text" class="form-input" required placeholder="Ahmet Yılmaz">
            </div>
            <div class="form-group">
                <label>Kart Numarası</label>
                <input type="text" class="form-input" required placeholder="4543 **** **** 1234">
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Son Kullanma Tarihi</label>
                    <input type="text" class="form-input" required placeholder="MM/YY">
                </div>
                <div class="form-group">
                    <label>CVV</label>
                    <input type="text" class="form-input" required placeholder="123">
                </div>
            </div>
            <button type="submit" class="btn btn-lg btn-success btn-block">
                Ödemeyi Onayla (₺<%= total.toFixed(2) %>)
            </button>
        </form>

        <div class="cart-summary">
            <h3>Siparişiniz</h3>
            <% cart.forEach(item => { %>
                <div class="summary-item">
                    <span><%= item.title %></span>
                    <span>₺<%= (item.discount_price || item.price).toFixed(2) %></span>
                </div>
            <% }); %>
            <hr>
            <div class="summary-row">
                <strong>Toplam:</strong>
                <strong>₺<%= total.toFixed(2) %></strong>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
