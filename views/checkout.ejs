<%- include('partials/header') %>

<section class="section">
  <div style="max-width:640px;margin:0 auto">
    <div class="section-title" style="text-align:left;margin-bottom:24px">
      <h2>💳 Güvenli Ödeme & Sipariş Tamamlama</h2>
      <p>Sipariş detaylarınızı onaylayın ve ödeme yöntemini seçin</p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert"><%= error %></div>
    <% } %>

    <% if (!items || !items.length) { %>
      <div class="empty">Sepetiniz boş. <a href="/oyunlar">Oyun kataloğuna git →</a></div>
    <% } else { %>
      <div class="cartlist" style="margin-bottom:16px">
        <% items.forEach(function (g) { %>
          <div class="cartrow" style="background:var(--card);border:1px solid var(--border);border-radius:12px;padding:14px 18px;margin-bottom:8px">
            <span class="cartrow-name" style="font-weight:700"><%= g.title %></span>
            <span class="price" style="font-size:1rem;color:var(--orange2);font-weight:800">₺<%= Number(g.price).toFixed(0) %></span>
          </div>
        <% }) %>
      </div>

      <!-- Fiyat Özeti Koyu Kutu -->
      <div style="background:var(--card2);border:1px solid var(--border2);border-radius:16px;padding:20px;margin-bottom:24px">
        <div style="display:flex;justify-content:space-between;font-size:.9rem;color:var(--muted);margin-bottom:6px">
          <span>Ara Toplam</span>
          <span>₺<%= Number(subtotal).toFixed(0) %></span>
        </div>

        <% if (typeof coupon !== 'undefined' && coupon && discount > 0) { %>
          <div style="display:flex;justify-content:space-between;font-size:.9rem;color:#4ade80;font-weight:700;margin-bottom:6px">
            <span>Kupon İndirimi (<%= coupon.code %>)</span>
            <span>- ₺<%= Number(discount).toFixed(0) %></span>
          </div>
        <% } %>

        <div style="display:flex;justify-content:space-between;font-size:1.25rem;font-weight:900;color:var(--text);border-top:1px solid var(--border);padding-top:12px;margin-top:8px">
          <span>Ödenecek Tutar</span>
          <span style="color:var(--orange2)">₺<%= Number(total).toFixed(0) %></span>
        </div>
      </div>

      <div style="background:var(--card);border:1px solid var(--border);border-radius:16px;padding:20px;margin-bottom:24px">
        <p style="font-size:.85rem;font-weight:700;color:var(--purple2);margin-bottom:8px;text-transform:uppercase;letter-spacing:.06em">ℹ️ Ödeme Seçenekleri</p>
        <p style="font-size:.9rem;color:var(--muted);line-height:1.6">Siparişi oluşturduktan sonra <strong>Banka Havale/EFT IBAN bilgileri</strong> gösterilecektir. Ödemeyi yapıp "⚡ Havaleyi Yaptım" butonuna bastığınızda admin siparişinizi onaylayacaktır.</p>
      </div>

      <form method="post" action="/odeme" class="form">
        <!-- Hediye Kutusu -->
        <div style="background:var(--card);border:1px solid var(--border);border-radius:16px;padding:18px 20px;margin-bottom:20px">
          <label style="cursor:pointer;display:flex;align-items:center;gap:10px;font-weight:700">
            <input type="checkbox" id="giftToggle" onchange="document.getElementById('giftInputWrap').style.display = this.checked ? 'block' : 'none'">
            🎁 Bu siparişi arkadaşıma / başka bir yayıncıya hediye et
          </label>
          <div id="giftInputWrap" style="display:none;margin-top:12px">
            <label style="font-size:.85rem;color:var(--muted)">Alıcının Reyiz Market E-posta Adresi:</label>
            <input name="gift_email" placeholder="yayin_arkadasi@gmail.com" style="margin-top:4px">
            <div style="font-size:.78rem;color:var(--muted);margin-top:4px">Ödeme onaylandığında oyun doğrudan alıcının kütüphanesine eklenecektir.</div>
          </div>
        </div>

        <button class="btn big" type="submit" style="width:100%;padding:16px;font-size:1.05rem">Siparişi Tamamla & IBAN Göster →</button>
      </form>
      <p class="note" style="margin-top:14px;text-align:center">🔒 %100 Güvenli Dijital Sipariş Altyapısı</p>
    <% } %>
  </div>
</section>

<%- include('partials/footer') %>